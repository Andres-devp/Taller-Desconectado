<?xml version="1.0" encoding="utf-8"?>
<!-- El sistema central corre en una red local (Docker en un portátil) sin TLS,
     por eso se permite HTTP en claro. En producción se usaría HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
